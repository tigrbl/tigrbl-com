{
  "name": "tigrbl-com",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && tsx scripts/build-static.tsx && npm run discovery:check && npm run performance:budget",
    "check": "tsc --noEmit",
    "preview": "node scripts/serve.mjs",
    "discovery:generate": "tsx scripts/build-static.tsx",
    "discovery:check": "tsx scripts/validate-site.ts",
    "demos:check": "tsx scripts/check-demos.ts",
    "performance:budget": "node scripts/check-budgets.mjs",
    "test:browser": "playwright test",
    "test:http": "node scripts/check-http.mjs",
    "performance:audit": "node scripts/audit-performance.mjs",
    "content:refresh": "node scripts/refresh-publications.mjs",
    "docker:build": "docker compose build tigrbl-com",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "deploy": "docker compose -f docker-compose.yaml up -d --build --force-recreate --no-deps tigrbl-com",
    "routing:validate": "uv run wyrmctl validate .wyrmctl/desired-state/production/desired-state.yaml",
    "routing:plan": "uv run wyrmctl plan .wyrmctl/desired-state/production/desired-state.yaml --owner tigrbl-com",
    "proxy:target-check": "node scripts/validate-proxy-target.mjs"
  },
  "engines": {
    "node": ">=22.19 <23"
  },
  "dependencies": {
    "@mdwrk/structured-data": "0.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prismjs": "1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "5.12.1",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
