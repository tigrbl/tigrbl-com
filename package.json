{
  "name": "tigrbl-com",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "docker:build": "docker compose build tigrbl-com",
    "dns:plan": "npmctl plan .npmctl/desired-state/production/dns.yaml --owner tigrbl-com",
    "dns:apply": "node -e \"throw Error('Use .github/workflows/npmctl.yml')\"",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "deploy": "docker compose -f docker-compose.yaml up -d --build --force-recreate --no-deps tigrbl-com",
    "dns:doctor": "npmctl dns doctor --provider namecheap",
    "proxy:validate": "npmctl validate .npmctl/desired-state/production/proxy.yaml",
    "proxy:plan": "npmctl plan .npmctl/desired-state/production/proxy.yaml --owner tigrbl-com",
    "proxy:apply": "node -e \"throw Error('Use .github/workflows/npmctl.yml')\"",
    "proxy:target-check": "node scripts/validate-proxy-target.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
