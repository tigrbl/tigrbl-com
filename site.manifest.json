{
  "host": "tigrbl.com",
  "zone": "tigrbl.com",
  "repository": "tigrbl/tigrbl-com",
  "siteKind": "mdwrk-lander",
  "orchestrator": "wyrmctl",
  "dnsProvider": "namecheap",
  "deployment": "self-hosted-docker",
  "dockerService": "tigrbl-com",
  "records": [
    {
      "type": "A",
      "host": "@",
      "value": "SITE_SERVER_IP_SECRET",
      "ttl": 300
    },
    {
      "type": "A",
      "host": "*.tigrbl.com",
      "value": "SITE_SERVER_IP_SECRET",
      "ttl": 300
    },
    {
      "type": "CNAME",
      "host": "www",
      "value": "tigrbl.com",
      "ttl": 300
    }
  ],
  "routing": {
    "provider": "portwyrm",
    "desiredState": ".wyrmctl/desired-state/production/desired-state.yaml"
  }
}
